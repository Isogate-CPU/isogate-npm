{
  "name": "@isogate/node",
  "version": "0.3.1",
  "type": "module",
  "description": "Cross-platform CPU diagnostics and deterministic workloads for Node.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/Isogate-CPU/isogate-npm.git",
    "directory": "lib/isogate-node"
  },
  "homepage": "https://github.com/Isogate-CPU/isogate-npm/tree/main/lib/isogate-node",
  "bugs": {
    "url": "https://github.com/Isogate-CPU/isogate-npm/issues"
  },
  "keywords": ["isogate", "deterministic-compute", "cpu-diagnostics", "replay"],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "bin": {
    "isogate-node": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pack:dry-run": "npm pack --dry-run"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@isogate/replay": "1.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "typescript": "^5.8.3"
  }
}